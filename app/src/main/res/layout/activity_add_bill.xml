<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E61A1A2E">

    <!-- 粒子光效层（不拦截触摸） -->
    <com.billbook.app.animation.ParticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ========== 顶部栏 ========== -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="记一笔"
                android:textColor="@color/anime_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- ========== 收支切换 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_anime_pay_chip"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/chipExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_anime_pay_chip_selected"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="支出"
                    android:textColor="#E0FFFFFF"
                    android:textSize="@dimen/text_xs" />

                <TextView
                    android:id="@+id/chipIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="收入"
                    android:textColor="@color/anime_text_hint"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== 主体滚动区 ========== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- 分类选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="选择分类"
                    android:textColor="@color/anime_text_secondary"
                    android:textSize="@dimen/text_sm" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpCategories"
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:id="@+id/layoutDotIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <!-- 金额显示区 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥"
                            android:textColor="@color/anime_text_secondary"
                            android:textSize="@dimen/text_xl"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAmountDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:hint="0.00"
                            android:textColor="@color/anime_text_primary"
                            android:textColorHint="@color/anime_text_hint"
                            android:textSize="36sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.billbook.app.animation.BubbleTipView
                        android:id="@+id/bubbleInputHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="-6dp" />
                </FrameLayout>

                <!-- 隐藏的金额输入框（触发数字键盘） -->
                <EditText
                    android:id="@+id/etMoney"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0"
                    android:inputType="numberDecimal"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <!-- 金额气泡提示 -->
                <com.billbook.app.animation.BubbleTipView
                    android:id="@+id/bubbleTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp" />

                <!-- 支付渠道 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="支付渠道"
                    android:textColor="@color/anime_text_secondary"
                    android:textSize="@dimen/text_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipWechat"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_anime_pay_chip_selected"
                        android:gravity="center"
                        android:text="微信"
                        android:textColor="@color/anime_text_primary"
                        android:textSize="@dimen/text_xs" />

                    <TextView
                        android:id="@+id/chipAlipay"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:text="支付宝"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="@dimen/text_xs" />

                    <TextView
                        android:id="@+id/chipCash"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:text="现金"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="@dimen/text_xs" />

                    <TextView
                        android:id="@+id/chipBank"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:text="银行卡"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

                <!-- 时间选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="消费时间"
                    android:textColor="@color/anime_text_secondary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_anime_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="点击选择时间"
                    android:textColor="@color/anime_text_primary"
                    android:textSize="@dimen/text_sm" />

                <!-- 备注/标签区 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="备注"
                    android:textColor="@color/anime_text_secondary"
                    android:textSize="@dimen/text_sm" />

                <!-- 常用标签 -->
                <LinearLayout
                    android:id="@+id/layoutTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tag1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="午餐"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="交通"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag3"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="购物"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag4"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_anime_pay_chip"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="娱乐"
                        android:textColor="@color/anime_text_secondary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 备注输入 -->
                <EditText
                    android:id="@+id/etRemark"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_anime_input"
                    android:hint="选填备注..."
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/anime_text_primary"
                    android:textColorHint="@color/anime_text_hint"
                    android:textSize="@dimen/text_sm" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ========== 底部按钮区 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="20dp"
            android:paddingTop="8dp">

            <com.billbook.app.animation.GlowButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_anime_button"
                android:gravity="center"
                android:text="确认记账"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="取消"
                android:textColor="@color/anime_text_hint"
                android:textSize="@dimen/text_sm"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
