<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 分类名称和金额 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍜"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="餐饮"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCategoryBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥500.00"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md" />
        </LinearLayout>

        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/progressCategory"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress_bar" />

        <!-- 消费和剩余 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategorySpent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已消费：¥0.00"
                android:textColor="@color/expense_red"
                android:textSize="@dimen/text_xs" />

            <TextView
                android:id="@+id/tvCategoryRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余：¥0.00"
                android:textColor="@color/income_green"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 状态和操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoryStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="预算充足"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="修改"
                android:textSize="@dimen/text_sm"
                app:cornerRadius="@dimen/radius_sm"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="删除"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/expense_red"
                app:cornerRadius="@dimen/radius_sm"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
