<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="26dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_overlay_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOverlayAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="-¥0.01"
                android:textColor="#F5FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvOverlayChannel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="农行 · 尾号8275"
                android:textColor="#A6FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOverlayHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="核对金额和收支，填名称可自动归类"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etOverlayAmount"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_input"
                android:contentDescription="记账金额（元）"
                android:hint="金额（元）"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="9"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#F0FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgOverlayType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOverlayExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:buttonTint="#B3FFFFFF"
                    android:text="支出"
                    android:textColor="#F0FFFFFF" />

                <RadioButton
                    android:id="@+id/rbOverlayIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:buttonTint="#B3FFFFFF"
                    android:text="收入"
                    android:textColor="#F0FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <EditText
            android:id="@+id/etOverlayTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:autofillHints="none"
            android:background="@drawable/bg_overlay_input"
            android:hint="例如：星巴克、打车、房租"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#F0FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvOverlayOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnOverlayIgnore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_ghost">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="忽略"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnOverlayConfirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1.6"
                android:background="@drawable/bg_overlay_primary">

                <TextView
                    android:id="@+id/tvOverlayConfirmLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="确认记入"
                    android:textColor="#CC3D4A5C"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOverlayCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="30 秒后自动收进「待确认」"
            android:textColor="#59FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
