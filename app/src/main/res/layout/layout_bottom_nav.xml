<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 导航栏主体 -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@drawable/bg_nav_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 账单 -->
        <LinearLayout
            android:id="@+id/navItemBills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconBills"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/selector_nav_bills" />

            <TextView
                android:id="@+id/navLabelBills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="账单"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 统计 -->
        <LinearLayout
            android:id="@+id/navItemStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconStats"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/selector_nav_stats" />

            <TextView
                android:id="@+id/navLabelStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="统计"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 占位：中间 FAB -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- 预算 -->
        <LinearLayout
            android:id="@+id/navItemBudget"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconBudget"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/navLabelBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="预算"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- 设置 -->
        <LinearLayout
            android:id="@+id/navItemSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/selector_nav_settings" />

            <TextView
                android:id="@+id/navLabelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="设置"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中间 FAB 按钮（凸起于导航栏上方） -->
    <FrameLayout
        android:id="@+id/fabAdd"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-16dp"
        android:background="@drawable/bg_glass_fab"
        android:elevation="0dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            android:tint="@android:color/white" />
    </FrameLayout>
</FrameLayout>
