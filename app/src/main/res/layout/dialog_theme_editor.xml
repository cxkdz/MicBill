<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="背景"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold"
            android:textColor="@color/anime_text_primary"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- 自定义背景图片 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义背景图片"
            android:textSize="@dimen/text_md"
            android:textStyle="bold"
            android:textColor="@color/anime_text_primary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择一张图片覆盖预设的渐变背景"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/anime_text_hint"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- 图片预览 -->
        <FrameLayout
            android:id="@+id/layoutImagePreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:background="@drawable/bg_glass_card"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <!-- 选择图片按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_lg">

            <FrameLayout
                android:id="@+id/btnPickImage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_anime_button">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="选择图片"
                    android:textColor="@color/anime_text_primary"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/btnClearImage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_anime_button"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="清除图片"
                    android:textColor="@color/anime_text_hint"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/anime_divider"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:text="取消"
                android:textColor="@color/anime_text_hint"
                android:textSize="@dimen/text_md" />

            <TextView
                android:id="@+id/btnApply"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:text="应用"
                android:textColor="@color/anime_accent"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
