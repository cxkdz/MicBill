<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 最外层深阴影 -->
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#800D0D1A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 中间层阴影 -->
    <item android:left="4dp" android:top="4dp" android:right="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#400D0D1A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 高光层 -->
    <item android:left="0dp" android:top="0dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 主体渐变 -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#22223A"
                android:centerColor="#1E1E34"
                android:endColor="#1A1A2E"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="0.5dp"
                android:color="#15FFFFFF" />
        </shape>
    </item>
</layer-list>
