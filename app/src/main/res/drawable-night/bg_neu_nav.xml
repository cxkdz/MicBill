<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 上方阴影 -->
    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:topLeftRadius="@dimen/radius_xl" android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
    <!-- 主体 -->
    <item android:top="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_bg" />
            <corners android:topLeftRadius="@dimen/radius_xl" android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
</layer-list>
