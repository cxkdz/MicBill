<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层阴影（右下） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <!-- 上层高光（左上）偏移 -->
    <item android:bottom="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <!-- 主体 - 带微妙渐变 -->
    <item android:bottom="3dp" android:right="3dp" android:top="1.5dp" android:left="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/neu_surface"
                android:endColor="@color/neu_bg"
                android:type="linear" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>
