<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="@dimen/decor_corner_radius" />
        </shape>
    </item>
    <item android:bottom="2dp" android:right="2dp" android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="@dimen/decor_corner_radius" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="3dp" android:top="1.5dp" android:left="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/neu_surface"
                android:endColor="@color/neu_bg"
                android:type="linear" />
            <corners android:radius="@dimen/decor_corner_radius" />
        </shape>
    </item>
</layer-list>
