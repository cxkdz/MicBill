<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内凹效果 - 左上阴影 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <!-- 内凹效果 - 右下高光 -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <!-- 主体 - 稍暗 -->
    <item android:top="3dp" android:left="3dp" android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_bg_dark" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</layer-list>
