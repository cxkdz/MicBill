<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部阴影 -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#20000000" />
            <corners
                android:topLeftRadius="@dimen/radius_xl"
                android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
    <!-- 高光底部 -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners
                android:topLeftRadius="@dimen/radius_xl"
                android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
    <!-- 主体 -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/neu_surface"
                android:endColor="@color/neu_bg"
                android:type="linear" />
            <corners
                android:topLeftRadius="@dimen/radius_xl"
                android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
</layer-list>
