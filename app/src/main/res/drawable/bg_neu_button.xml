<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 右下阴影 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <!-- 左上高光 -->
    <item android:bottom="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <!-- 主体 -->
    <item android:bottom="2.5dp" android:right="2.5dp" android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_bg" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</layer-list>
