<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层光晕 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#206B8DD6" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- 主体按钮 -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#5A7BC8"
                android:startColor="#8BA7E8"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
